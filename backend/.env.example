# Django Core Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Organization & Executive Admin Identity
PRIMARY_ADMIN_EMAIL=admin@example.com
DEFAULT_ORGANIZATION=Enterprise Organization

# Microsoft Graph API & Teams Integration
MS_CLIENT_ID=your-azure-ad-app-client-id
MS_CLIENT_SECRET=your-azure-ad-app-client-secret
MS_TENANT_ID=your-azure-ad-tenant-id
MS_REDIRECT_URI=http://localhost:5173/auth/callback
MS_USER_EMAIL=user@example.com

# Frontend URL
FRONTEND_URL=http://localhost:5173

# OpenAI Intelligence Engine (Whisper & GPT-4o-mini)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# PostgreSQL Database Configuration
DB_NAME=meeting_intelligence
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432
